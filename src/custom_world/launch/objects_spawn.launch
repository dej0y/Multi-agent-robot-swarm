<launch>
  <!-- Launch Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch"/>

  <!-- Load URDF -->
  <param name="robot_description" command="$(find xacro)/xacro $(find custom_world)/urdf/fire_extinguisher.urdf"/>

  <!-- Spawn the object -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-param robot_description -urdf -model fire_extinguisher -x 0 -y 0 -z 5"/>
</launch>
