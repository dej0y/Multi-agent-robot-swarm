<?xml version="1.0" ?>
<robot name="turtlebot3_burger" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="namespace" default=""/>
  <xacro:include filename="$(find turtlebot3_description)/urdf/common_properties.xacro"/>
  <!-- <xacro:include filename="$(find turtlebot3_description)/urdf/turtlebot3_burger.gazebo.xacro"/> -->

  <xacro:property name="ns" value="$(arg namespace)"/>
  <xacro:property name="tf_prefix" value="${ns}/"/>
  <xacro:arg name="laser_visual" default="false"/>
  <xacro:arg name="imu_visual"   default="false"/>
  <xacro:property name="laser_visual" value="$(arg laser_visual)"/>
  <xacro:property name="imu_visual" value="$(arg imu_visual)"/>
  <xacro:property name="camera_visual" value="$(arg camera_visual)"/>
  <xacro:property name="r200_cam_rgb_px" value="0.005"/>
  <xacro:property name="r200_cam_rgb_py" value="0.018"/>
  <xacro:property name="r200_cam_rgb_pz" value="0.013"/>
  <xacro:property name="r200_cam_depth_offset" value="0.01"/>
  <xacro:arg name="gpu" default="false"/>
  <xacro:property name="gpu" value="$(arg gpu)" />

  <gazebo reference="${tf_prefix}base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="${tf_prefix}wheel_left_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="${tf_prefix}wheel_right_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="${tf_prefix}caster_back_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo>
    <plugin name="${ns}/turtlebot3_burger_controller" filename="libgazebo_ros_diff_drive.so">
      <!-- <robotns>${ns}</robotns> -->
      <odometryTopic>${ns}/odom</odometryTopic>
      <odometryFrame>${ns}/odom</odometryFrame>
      <odometrySource>world</odometrySource>
      <commandTopic>${ns}/cmd_vel</commandTopic>
      <publishOdomTF>true</publishOdomTF>
      <robotBaseFrame>${ns}/base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishTf>true</publishTf>
      <publishWheelJointState>true</publishWheelJointState>
      <legacyMode>false</legacyMode>
      <updateRate>30</updateRate>
      <leftJoint>${tf_prefix}wheel_left_joint</leftJoint>
      <rightJoint>${tf_prefix}wheel_right_joint</rightJoint>
      <wheelSeparation>0.160</wheelSeparation>
      <wheelDiameter>0.066</wheelDiameter>
      <wheelAcceleration>0.5</wheelAcceleration>
      <wheelTorque>10</wheelTorque>
      <!-- <rosDebugLevel>na</rosDebugLevel> -->
      <rosDebugLevel>warn</rosDebugLevel>
    </plugin>
  </gazebo>

  <gazebo reference="${tf_prefix}imu_link">
    <sensor type="imu" name="imu">
      <always_on>true</always_on>
      <visualize>$(arg imu_visual)</visualize>
    </sensor>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo>
    <plugin name="${ns}/imu_plugin" filename="libgazebo_ros_imu.so">
      <robotns>${ns}</robotns>
      <alwaysOn>true</alwaysOn>
      <bodyName>${tf_prefix}imu_link</bodyName>
      <frameName>${ns}/imu_link</frameName>
      <topicName>${ns}/imu</topicName>
      <serviceName>${ns}/imu_service</serviceName>
      <gaussianNoise>0.0</gaussianNoise>
      <updateRate>0</updateRate>
    </plugin>
  </gazebo>

  <gazebo reference="${tf_prefix}base_scan">
    <material>Gazebo/FlatBlack</material>
    <sensor type="ray" name="${ns}/lds_lfcd_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>${laser_visual}</visualize>
      <update_rate>60</update_rate>
      <ray>
        <scan>
          <horizontal>
            <resolution>1</resolution>
            <samples>24</samples>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
            <!-- <samples>360</samples>
            <min_angle>0</min_angle>
            <max_angle>6.28</max_angle> -->
          </horizontal>
        </scan>
        <range>
          <min>0.015</min>
          <max>5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="${ns}/gazebo_ros_lds_lfcd_controller" filename="libgazebo_ros_laser.so">
        <topicName>${ns}/scan</topicName>
        <frameName>${ns}/base_scan</frameName>
        <robotns>${ns}</robotns>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="${tf_prefix}camera_rgb_frame">
    <sensor type="depth" name="realsense_R200">
      <always_on>true</always_on>
      <visualize>$(arg camera_visual)</visualize>
      <camera>
          <horizontal_fov>1.3439</horizontal_fov>
          <image>
              <width>640</width>
              <height>640</height>
              <format>R8G8B8</format>
          </image>
          <depth_camera></depth_camera>
          <clip>
              <near>0.03</near>
              <far>100</far>
          </clip>
      </camera>
      <plugin name="${ns}/camera_controller" filename="libgazebo_ros_openni_kinect.so">
        <baseline>0.2</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <cameraName>camera</cameraName>
        <frameName>camera_rgb_optical_frame</frameName>
        <imageTopicName>rgb/image_raw</imageTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudCutoff>0.4</pointCloudCutoff>
            <hackBaseline>0.07</hackBaseline>
            <distortionK1>0.0</distortionK1>
            <distortionK2>0.0</distortionK2>
            <distortionK3>0.0</distortionK3>
            <distortionT1>0.0</distortionT1>
            <distortionT2>0.0</distortionT2>
        <CxPrime>0.0</CxPrime>
        <Cx>0.0</Cx>
        <Cy>0.0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>

  <link name="${tf_prefix}base_footprint"/>

  <joint name="${tf_prefix}base_joint" type="fixed">
    <parent link="${tf_prefix}base_footprint"/>
    <child link="${tf_prefix}base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="${tf_prefix}base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.143"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.2573504e-01"/>
      <inertia ixx="2.2124416e-03" ixy="-1.2294101e-05" ixz="3.4938785e-05"
                iyy="2.1193702e-03" iyz="-5.0120904e-06"
                izz="2.0064271e-03" />
    </inertial>
  </link>

  <joint name="${tf_prefix}wheel_left_joint" type="continuous">
    <parent link="${tf_prefix}base_link"/>
    <child link="${tf_prefix}wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${tf_prefix}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <joint name="${tf_prefix}wheel_right_joint" type="continuous">
    <parent link="${tf_prefix}base_link"/>
    <child link="${tf_prefix}wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${tf_prefix}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <joint name="${tf_prefix}caster_back_joint" type="fixed">
    <parent link="${tf_prefix}base_link"/>
    <child link="${tf_prefix}caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${tf_prefix}caster_back_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="${tf_prefix}imu_joint" type="fixed">
    <parent link="${tf_prefix}base_link"/>
    <child link="${tf_prefix}imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="${tf_prefix}imu_link"/>

  <joint name="${tf_prefix}scan_joint" type="fixed">
    <parent link="${tf_prefix}base_link"/>
    <child link="${tf_prefix}base_scan"/>
    <origin xyz="-0.032 0 0.172" rpy="0 0 0"/>
  </joint>

  <link name="${tf_prefix}base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <!-- <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry> -->
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>
    
  <joint name="${tf_prefix}camera_joint" type="fixed">
    <origin xyz="0.064 -0.065 0.094" rpy="0 0 0"/>
    <parent link="${tf_prefix}base_link"/>
    <child link="${tf_prefix}camera_link"/>
  </joint>

  <link name="${tf_prefix}camera_link">
    <visual>
     <origin xyz="0 0 0" rpy="1.57 0 1.57"/>
      <geometry>
       <mesh filename="package://turtlebot3_description/meshes/sensors/r200.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.003 0.065 0.007" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.132 0.020"/>
      </geometry>
    </collision>

    <!-- This inertial field needs doesn't contain reliable data!! -->
<!--   <inertial>
      <mass value="0.564" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0"
               iyy="0.000498940" iyz="0.0"
               izz="0.003879257" />
    </inertial>-->
  </link>

  <joint name="${tf_prefix}camera_rgb_joint" type="fixed">
    <origin xyz="${r200_cam_rgb_px} ${r200_cam_rgb_py} ${r200_cam_rgb_pz}" rpy="0 0 0"/>
    <parent link="${tf_prefix}camera_link"/>
    <child link="${tf_prefix}camera_rgb_frame"/>
  </joint>
  <link name="${tf_prefix}camera_rgb_frame"/>

  <joint name="${tf_prefix}camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="${tf_prefix}camera_rgb_frame"/>
    <child link="${tf_prefix}camera_rgb_optical_frame"/>
  </joint>
  <link name="${tf_prefix}camera_rgb_optical_frame"/>

  <joint name="${tf_prefix}camera_depth_joint" type="fixed">
    <origin xyz="${r200_cam_rgb_px} ${r200_cam_rgb_py + r200_cam_depth_offset} ${r200_cam_rgb_pz}" rpy="0 0 0"/>
    <parent link="${tf_prefix}camera_link"/>
    <child link="${tf_prefix}camera_depth_frame"/>
  </joint>
  <link name="${tf_prefix}camera_depth_frame"/>

  <joint name="${tf_prefix}camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="${tf_prefix}camera_depth_frame"/>
    <child link="${tf_prefix}camera_depth_optical_frame"/>
  </joint>
  <link name="${tf_prefix}camera_depth_optical_frame"/>

  <!-- <link name="${tf_prefix}3dlidar_link"/>  -->
  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
  <xacro:VLP-16 parent="${tf_prefix}base_link" name="${tf_prefix}velodyne" topic="${tf_prefix}/velodyne_points" hz="10" samples="440" gpu="${gpu}">
    <origin xyz="-0.05 0 0.14" rpy="0 0 0" />
  </xacro:VLP-16>



  <gazebo>
    <robotns>${ns}</robotns>
  </gazebo>



</robot>
